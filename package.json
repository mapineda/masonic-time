{
  "name": "masonic-time",
  "version": "1.3.0",
  "description": "A Javascript date library for parsing, validating, manipulating, and formatting Masonic dates.",
  "author": "Marco Pineda",
  "keywords": [
    "freemason",
    "masonic",
    "anno lucis",
    "time",
    "date-time",
    "formatting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapineda/masonic-time.git"
  },
  "bugs": {
    "url": "https://github.com/mapineda/masonic-time/issues"
  },
  "homepage": "https://github.com/mapineda/masonic-time#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "js-yaml": "^4.1.0"
  }
}
